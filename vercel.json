{
  "routes": [
    { "src": "^/sneak/?$", "status": 307, "headers": { "Location": "/sneak/index.html" } },
    { "src": "^/sneak/(.*)$", "dest": "/$1" },
    { "src": "^/$", "dest": "/coming-soon.html" },
    { "src": "^/(index|coming-soon|lagos|social|menu|about|reservations)(\\.html)?/?$", "status": 307, "headers": { "Location": "/" } },

    { "src": "^/(css|js)/.*", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/assets/fonts/.*", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/assets/(img|logo|print)/.*", "headers": { "cache-control": "public, max-age=604800" }, "continue": true },

    { "handle": "filesystem" }
  ]
}
